# GEMINI_API_KEY: Primary AI provider for the textbook->mastery pipeline.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fallback provider (fast LPU inference, free tier).
# Tried only when Gemini is unavailable or overloaded. Skip if not configured.
GROQ_API_KEY="MY_GROQ_API_KEY"

# NVIDIA_API_KEY: Optional fallback provider (build.nvidia.com, free tier, 40 RPM).
# Tried after Gemini and before Groq. Skip if not configured.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon/Postgres connection string. When set, the server creates
# its tables, enables passwordless (magic-link) accounts, and syncs workspaces
# + study events to the database. When NOT set, the app runs in local mode
# (localStorage only, no login) so dev/tests/offline always work.
# Example (Neon): postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Example (local dev via `docker compose up -d`): postgres://awde:awde@localhost:5432/awde?sslmode=disable
DATABASE_URL=""

# RESEND_API_KEY: used to EMAIL one-time login links (passwordless auth).
# Get one at https://resend.com (free tier covers low-volume MVP).
# When not set, dev mode prints the login link to the server console + shows a
# "Dev link" in the UI; production refuses to send instead.
RESEND_API_KEY=""

# RESEND_FROM_ADDRESS: the "from" shown on login emails. When empty, the
# default is "Awde <onboarding@resend.dev>".
#
# CAUTION (deliverability): onboarding@resend.dev is Resend's TEST-only mailbox
# — it can only deliver to the Resend account owner's own inbox. Every other
# recipient is rejected (403). To send login links to real users ("clients and
# daily use") you must:
#   1. verify a domain you own in the Resend dashboard (adds SPF/DKIM,
#      usually < 1 hour),
#   2. set RESEND_FROM_ADDRESS="Awde <hello@yourdomain.com>".
RESEND_FROM_ADDRESS=""
