# OPENROUTER_API_KEY: PRIMARY AI provider. One key in front of 400+ models.
# Get one at https://openrouter.ai/keys — top up with free credits (many models
# are $0). The app routes every AI request here FIRST.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: which model OpenRouter serves. Defaults to "openrouter/free"
# (the $0 auto-router meta-model; its backing model list self-updates). Set this
# to pin a specific model, e.g. "openrouter/auto" or "meta-llama/llama-3.3-70b"
# if a stable model is preferred for CI/containers.
# OPENROUTER_MODEL="openrouter/free"

# GROQ_API_KEY: Optional fallback provider #1 (fast LPU inference, free tier).
# Tried only when OpenRouter is unavailable or overloaded. Skip if not configured.
GROQ_API_KEY="MY_GROQ_API_KEY"

# NVIDIA_API_KEY: Optional fallback provider #2 (build.nvidia.com, free tier, RPM-capped).
# Tried after Groq. Skip if not configured.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# AI providers are tried in order on EVERY request: OpenRouter -> Groq -> NVIDIA,
# then a deterministic offline generator as the last resort. One dead/expired
# key never breaks the app. A bad key that fails 3x in a row is skipped for a
# minute (circuit breaker), then retried automatically.
#
# KEY HANDLING (production-grade rules):
# - Keys live ONLY in the environment: `.env` locally, Render service secrets
#   (`sync: false`) in prod. Never git-commit them, never log them, never send
#   them to the browser.
# - The server logs provider NAMES only (see `server/secrets.ts`).
# - To rotate a key: set the new value in the provider dashboard + here, then
#   restart. The chain + circuit breaker absorb the gap with zero user-visible
#   outage.

# --- Free-tier daily quotas (per client fingerprint, pre-auth) ---
# The per-minute rate limits bound bursts; these ceiling daily AI spend so the
# free tier can't be burned by one script. Numbers are per fingerprint/day.
FREE_TIER_MINDMAPS_PER_DAY="30"
FREE_TIER_QUIZZES_PER_DAY="120"
FREE_TIER_CHAT_RESPONSES_PER_DAY="240"
FREE_TIER_TEXTBOOK_PROCESSES_PER_DAY="10"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints (also sent
# to OpenRouter as an attribution referer).
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon/Postgres connection string. When set, the server creates
# its tables, enables passwordless (magic-link) accounts, syncs workspaces
# + study events to the database, AND caches AI generations (repeat requests
# are served from Postgres without spending tokens). When NOT set, the app runs
# in local mode (localStorage only, no login) so dev/tests/offline always work.
# Example (Neon): postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Example (local dev via `docker compose up -d`): postgres://awde:awde@localhost:5432/awde?sslmode=disable
DATABASE_URL=""

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: enable the "Continue with Google"
# button (Better Auth OAuth). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials (Authorized redirect URI:
# {APP_URL}/api/ba/callback/google). When unset, the button is hidden and only
# email magic-link login is offered. These are secrets: keep in the env only.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# BETTER_AUTH_SECRET: signs Better Auth (Google OAuth) cookies. Generate one:
#   openssl rand -base64 32
# When empty, the server derives a random-but-stable secret from APP_URL, which
# is fine for local dev; set a real value in production.
# BETTER_AUTH_SECRET=""

# RESEND_API_KEY: used to EMAIL one-time login links (passwordless auth).
# Get one at https://resend.com (free tier covers low-volume MVP).
# When not set, dev mode prints the login link to the server console + shows a
# "Dev link" in the UI; production refuses to send instead.
RESEND_API_KEY=""

# RESEND_FROM_ADDRESS: the "from" shown on login emails. When empty, the
# default is "Awde <onboarding@resend.dev>".
#
# CAUTION (deliverability): onboarding@resend.dev is Resend's TEST-only mailbox
# — it can only deliver to the Resend account owner's own inbox. Every other
# recipient is rejected (403). To send login links to real users ("clients and
# daily use") you must EITHER:
#   a. verify a domain you own in the Resend dashboard (adds SPF/DKIM,
#      usually < 1 hour), then set RESEND_FROM_ADDRESS="Awde <hello@yourdomain.com>"
#   b. OR use the free Gmail SMTP transport below (works for any recipient,
#      ~500 emails/day, no domain needed).
RESEND_FROM_ADDRESS=""

# --- FREE Gmail SMTP transport (alternative to a verified Resend domain) ---
# Sends login links + contact messages from your own Gmail to ANY address.
# Requires an APP PASSWORD, not your Gmail login password:
#   1. Google Account -> Security -> 2-Step Verification -> ON (mandatory)
#   2. Google Account -> Security -> App passwords -> create one for "Mail"
#   3. Put that 16-character app password in SMTP_PASS below.
# When SMTP_* is set and RESEND_API_KEY is empty, SMTP wins.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional custom display name, e.g. "Awde <lewikb13@gmail.com>"
SMTP_FROM=""

# CONTACT_RECIPIENT: the inbox that receives /api/contact form messages.
# Defaults to lewikb13@gmail.com when empty. Because contact mail goes TO the
# team, the free Resend test mailbox delivers it without a verified domain.
CONTACT_RECIPIENT="lewikb13@gmail.com"